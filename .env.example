# Jira API Configuration Example
# Copy this file to .env.local and fill in your actual values
# .env.local is gitignored and will not be committed

# Your Jira instance URL (without trailing slash)
# Example: https://your-domain.atlassian.net
JIRA_BASE_URL=

# Your Jira account email
JIRA_EMAIL=

# Your Jira API token
# Generate one at: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=

# Optional: used by the calendar-import ticket picker's issue pool.
# JIRA_BOARD_ID: the number at the end of your sprint board's URL
#   (.../jira/software/projects/XXX/boards/<id>). Pulls in every issue on
#   that board's active sprint, not just yours.
# JIRA_EXTRA_FILTER_ID: the number from a saved filter's URL
#   (.../issues/?filter=<id>), for issues worth offering that aren't on the
#   sprint. Both are optional — "assigned to me" issues are always included.
JIRA_BOARD_ID=
JIRA_EXTRA_FILTER_ID=
